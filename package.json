{
  "name": "pulseflow",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "PulseFlow is a free, open-source, local-first workflow automation studio.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "esbuild", "electron-winstaller"]
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "pnpm --filter @pulseflow/server dev",
    "dev:web": "pnpm --filter @pulseflow/desktop dev:web",
    "dev:desktop": "pnpm --filter @pulseflow/desktop dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:templates": "vitest run packages/templates/src/catalog.test.ts",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "license:audit": "node scripts/license-audit.mjs",
    "build": "pnpm --filter @pulseflow/desktop build && pnpm --filter @pulseflow/server build",
    "package:win": "pnpm --filter @pulseflow/desktop package:win",
    "start": "pnpm --filter @pulseflow/server start",
    "pulseflow": "tsx packages/cli/src/main.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "@playwright/test": "1.64.0",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
