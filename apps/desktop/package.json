{
  "name": "@pulseflow/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev": "concurrently -n web,electron \"vite\" \"tsx electron/main.ts\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package:win": "vite build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "@pulseflow/contracts": "workspace:*",
    "@pulseflow/server": "workspace:*",
    "@pulseflow/editor": "workspace:*",
    "@pulseflow/ui": "workspace:*",
    "@tanstack/react-query": "5.104.2",
    "@xyflow/react": "12.12.0",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  }
}
